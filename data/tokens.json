{
  "$description": "design-engine default tokens (W3C Design Tokens spec). Generated from data/tokens/*.json and TOK-classified rules in docs/triage-69-rules.md.",
  "color": {
    "$type": "color",
    "brand": {
      "primary": { "$value": "#721FE5", "$description": "Main brand accent (purple)" },
      "dark": { "$value": "#030213", "$description": "Dark brand color, used as primary UI color" }
    },
    "neutral": {
      "50": { "$value": "#FAFAF9" },
      "100": { "$value": "#F4F1EC" },
      "200": { "$value": "#E8E6E1" },
      "300": { "$value": "#CBCED4" },
      "400": { "$value": "#9B9B9B" },
      "500": { "$value": "#7A7A7A" },
      "600": { "$value": "#6A6A6A" },
      "700": { "$value": "#3C3C3C" },
      "800": { "$value": "#2A2A2A" },
      "900": { "$value": "#030213" }
    },
    "text": {
      "primary": { "$value": "#3C3C3C", "$description": "Main headings, metric values" },
      "secondary": { "$value": "#6A6A6A", "$description": "Labels, captions, descriptions" },
      "tertiary": { "$value": "#7A7A7A", "$description": "Subtitles, axis labels, helper text" },
      "disabled": { "$value": "#9B9B9B", "$description": "Inactive nav, disabled states" }
    },
    "surface": {
      "page": { "$value": "#FAFAFA", "$description": "Page background (light gray)" },
      "subtle": { "$value": "#FAFAF9", "$description": "List item, alt card background" },
      "muted": { "$value": "#E8E6E1", "$description": "Progress bars, borders, inactive controls" },
      "brand-tint": { "$value": "#F0E8FF", "$description": "Brand-tinted highlight (selected row)" }
    },
    "icon": {
      "default": { "$value": "#4A5568", "$description": "Default icon color (blue-gray)" }
    },
    "alert": {
      "badge": { "$value": "#FF4444", "$description": "Notification badge red" }
    },
    "semantic": {
      "background": { "$value": "#FFFFFF" },
      "surface": { "$value": "#FFFFFF" },
      "foreground": { "$value": "#030213" },
      "muted-bg": { "$value": "#ECECF0" },
      "muted-fg": { "$value": "#717182" },
      "border": { "$value": "rgba(0,0,0,0.1)" },
      "input-background": { "$value": "#F3F3F5" },
      "switch-background": { "$value": "#CBCED4" },
      "success": { "$value": "#6B9B7A" },
      "destructive": { "$value": "#D4183D" },
      "warning": { "$value": "#D97706" },
      "info": { "$value": "#3B82F6" }
    },
    "chart": {
      "1": { "$value": "oklch(0.646 0.222 41.116)" },
      "2": { "$value": "oklch(0.6 0.118 184.704)" },
      "3": { "$value": "oklch(0.398 0.07 227.392)" },
      "4": { "$value": "oklch(0.828 0.189 84.429)" },
      "5": { "$value": "oklch(0.769 0.188 70.08)" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Inter", "Pretendard", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"] },
    "mono": { "$value": ["JetBrains Mono", "Fira Code", "monospace"] }
  },
  "typography": {
    "size": {
      "$type": "dimension",
      "2xs": { "$value": "10px" },
      "xs": { "$value": "11px" },
      "sm": { "$value": "12px" },
      "caption": { "$value": "13px" },
      "base": { "$value": "14px" },
      "body": { "$value": "15px" },
      "md": { "$value": "16px" },
      "subhead": { "$value": "17px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "3xl": { "$value": "30px" },
      "4xl": { "$value": "36px" },
      "5xl": { "$value": "48px" }
    },
    "weight": {
      "$type": "fontWeight",
      "normal": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "none": { "$value": 1.0 },
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.65 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tighter": { "$value": "-0.02em" },
      "tight": { "$value": "-0.01em" },
      "normal": { "$value": "0em" },
      "wide": { "$value": "0.05em" },
      "wider": { "$value": "0.1em" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "6px" },
    "2": { "$value": "12px" },
    "3": { "$value": "18px" },
    "4": { "$value": "24px" },
    "5": { "$value": "30px" },
    "6": { "$value": "36px" },
    "8": { "$value": "48px" },
    "10": { "$value": "60px" },
    "12": { "$value": "72px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "calc(0.625rem - 4px)" },
    "md": { "$value": "calc(0.625rem - 2px)" },
    "lg": { "$value": "0.625rem" },
    "xl": { "$value": "calc(0.625rem + 4px)" },
    "2xl": { "$value": "1rem" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "card": { "$value": { "color": "rgba(0,0,0,0.04)", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }, "$description": "Default card resting shadow" },
    "button": { "$value": { "color": "rgba(0,0,0,0.06)", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" } },
    "cardHover": { "$value": { "color": "rgba(0,0,0,0.08)", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" } },
    "elevated": { "$value": { "color": "rgba(0,0,0,0.08)", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } },
    "modal": { "$value": { "color": "rgba(0,0,0,0.12)", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }, "$description": "Modal / dialog elevation" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "100ms" },
      "normal": { "$value": "200ms" },
      "slow": { "$value": "350ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "default": { "$value": [0.4, 0, 0.2, 1] },
      "in": { "$value": [0.4, 0, 1, 1] },
      "out": { "$value": [0, 0, 0.2, 1] },
      "spring": { "$value": [0.34, 1.56, 0.64, 1] }
    }
  }
}
