---
// Generated by design-engine /design-settings-page
// Adapter: astro
// Dev-only — gate with import.meta.env.DEV in the route
//
// Note: This is a dev-only token viewer. Edits produce a copyable CSS snippet —
//       paste it into your theme.css to apply. Live write-back is a v0.x feature.
---

<style is:global>
  /* Settings page styles — scope to dev-only route */
</style>

<div class="max-w-[800px] mx-auto p-6 space-y-6">
  <h1 class="text-[24px] font-bold">Design Engine Settings</h1>
  <p class="text-[14px] text-text-secondary">
    Tweak design tokens. Edits produce a copyable CSS snippet — paste into theme.css to apply.
  </p>

  <div class="bg-card p-6 rounded-2xl space-y-4">
    <h2 class="text-[18px] font-bold">Colors</h2>
    <div id="color-controls" class="space-y-2">
      <!-- Populated by client-side script -->
    </div>
  </div>

  <div class="bg-card p-6 rounded-2xl">
    <h2 class="text-[18px] font-bold mb-4">Font</h2>
    <select id="font-select" class="w-full p-2 border rounded-md">
      <option>Inter</option>
      <option>Pretendard</option>
      <option>Geist</option>
      <option>DM Sans</option>
      <option>System default</option>
    </select>
  </div>

  <div class="bg-card p-6 rounded-2xl">
    <h2 class="text-[18px] font-bold mb-4">Live Preview</h2>
    <div id="preview" class="p-4 rounded-2xl bg-card shadow-[var(--shadow-card)]">
      <p class="text-[12px] uppercase tracking-wide font-bold">SAMPLE CARD</p>
      <p class="text-[36px] font-bold">$48.2<span class="text-[18px]">K</span></p>
      <p id="trend" class="text-[13px] font-bold text-success">+8.2% vs last month</p>
      <button id="cta" class="mt-4 px-4 py-2 rounded-md text-white font-medium">
        Primary Action
      </button>
    </div>
  </div>

  <div class="bg-card p-6 rounded-2xl space-y-4">
    <h2 class="text-[18px] font-bold">Generated CSS</h2>
    <pre id="css-output" class="bg-[#FAFAFA] p-4 rounded-md overflow-x-auto text-[13px]"></pre>
    <div class="flex gap-2">
      <button id="copy-btn" class="px-4 py-2 bg-primary text-white rounded-md">Copy CSS</button>
      <button id="download-btn" class="px-4 py-2 border rounded-md">Download theme.css</button>
    </div>
  </div>
</div>

<script>
  const DEFAULT_TOKENS = {
    brand: "#721FE5",
    primary: "#030213",
    background: "#FAFAFA",
    card: "#FFFFFF",
    foreground: "#2A2A2A",
    destructive: "#d4183d",
    success: "#6B9B7A",
    warning: "#D97706",
    info: "#3B82F6",
    font: "Inter",
  };
  const tokens: Record<string, string> = { ...DEFAULT_TOKENS };

  const colorControls = document.getElementById("color-controls")!;
  const cssOutput = document.getElementById("css-output")!;
  const cta = document.getElementById("cta") as HTMLButtonElement | null;
  const fontSelect = document.getElementById("font-select") as HTMLSelectElement | null;

  function generateCss() {
    return `:root {
  --brand: ${tokens.brand};
  --primary: ${tokens.primary};
  --background: ${tokens.background};
  --card: ${tokens.card};
  --foreground: ${tokens.foreground};
  --destructive: ${tokens.destructive};
  --success: ${tokens.success};
  --warning: ${tokens.warning};
  --info: ${tokens.info};
  --font-primary: ${tokens.font}, system-ui, sans-serif;
}`;
  }

  function update() {
    cssOutput.textContent = generateCss();
    if (cta) cta.style.background = tokens.brand;
  }

  // Build color controls using safe DOM methods (avoid innerHTML)
  for (const [key, value] of Object.entries(tokens)) {
    if (key === "font") continue;
    const row = document.createElement("div");
    row.className = "flex items-center gap-4";

    const label = document.createElement("label");
    label.className = "w-32 text-[14px] font-mono";
    label.textContent = `--${key}`;

    const colorInput = document.createElement("input");
    colorInput.type = "color";
    colorInput.value = value;
    colorInput.dataset.key = key;
    colorInput.className = "w-16 h-10";

    const textInput = document.createElement("input");
    textInput.type = "text";
    textInput.value = value;
    textInput.dataset.key = key;
    textInput.className = "font-mono p-2 border rounded-md";

    row.appendChild(label);
    row.appendChild(colorInput);
    row.appendChild(textInput);
    colorControls.appendChild(row);
  }

  // Bind events
  colorControls.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement;
    const key = target.dataset.key;
    if (!key) return;
    tokens[key] = target.value;
    // Sync paired input
    colorControls.querySelectorAll(`[data-key="${key}"]`).forEach((el) => {
      if (el !== target) (el as HTMLInputElement).value = target.value;
    });
    update();
  });

  if (fontSelect) {
    fontSelect.addEventListener("change", () => {
      tokens.font = fontSelect.value;
      update();
    });
  }

  document.getElementById("copy-btn")!.addEventListener("click", () => {
    navigator.clipboard.writeText(generateCss());
    alert("CSS copied — paste into your theme.css :root block.");
  });

  document.getElementById("download-btn")!.addEventListener("click", () => {
    const blob = new Blob([generateCss()], { type: "text/css" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "theme.css";
    a.click();
    URL.revokeObjectURL(url);
  });

  update();
</script>
