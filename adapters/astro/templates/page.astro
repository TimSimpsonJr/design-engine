---
// Generated by design-engine /design-page
// Recipe: <RECIPE_NAME>
// Adapter: astro
// Reference: see design-language skill rules 14, 18, 19, 61-63
interface Props {
  title?: string;
}
const { title = "<PAGE_NAME>" } = Astro.props;
---

<div class="max-w-[430px] mx-auto pb-24 bg-background min-h-screen">
  <!-- TopBar -->
  <header class="px-6 py-4 flex items-center justify-between">
    <h1 class="text-[18px] font-bold text-foreground">{title}</h1>
    <p class="text-[13px] text-text-tertiary">Today</p>
  </header>

  <!-- Hero card (mx-6 wrapping built in) -->
  <section class="mx-6 bg-card rounded-2xl p-6 shadow-[var(--shadow-card)] mb-6">
    <p class="text-[12px] uppercase tracking-wide text-text-secondary font-bold mb-2">PRIMARY METRIC</p>
    <p class="text-[48px] font-bold leading-none text-foreground">
      0<span class="text-[24px] ms-0.5 text-text-secondary">unit</span>
    </p>
    <p class="text-[13px] text-success font-bold mt-2">+0.0% vs last period</p>
  </section>

  <!-- KPI grid (px-6 on grid container) -->
  <section class="grid grid-cols-2 gap-4 px-6 mb-6">
    <!-- KPI cards: fill in 2 or 4 per recipe -->
    <div class="bg-card rounded-2xl p-4 shadow-[var(--shadow-card)]">
      <p class="text-[12px] uppercase tracking-wide text-text-secondary font-bold mb-2">METRIC</p>
      <p class="text-[36px] font-bold leading-none">0<span class="text-[18px] ms-0.5">u</span></p>
    </div>
    <div class="bg-card rounded-2xl p-4 shadow-[var(--shadow-card)]">
      <p class="text-[12px] uppercase tracking-wide text-text-secondary font-bold mb-2">METRIC</p>
      <p class="text-[36px] font-bold leading-none">0<span class="text-[18px] ms-0.5">u</span></p>
    </div>
  </section>

  <!-- Section card with list (mx-6 built in) -->
  <section class="mx-6 bg-card rounded-2xl p-6 mb-6 shadow-[var(--shadow-card)]">
    <h3 class="text-[18px] font-bold mb-4">Recent Activity</h3>
    <!-- List items go here -->
  </section>
</div>
